 {id:16,t:'Vintage Levi\u2019s 501 — 32×30', price:28, cat:'fashion', cond:'Good', emoji:'👖', s:'Ava L.', dorm:'Cedar Hall', mins:950, saves:11, trade:true, desc:'Proper vintage, proper fade. Might trade for records — pitch me what you have.'},
 {id:17,t:'Yoga mat + 2 blocks', price:10, cat:'sports', cond:'Like new', emoji:'🧘', s:'Nia J.', dorm:'Elm Hall', mins:1700, saves:3, desc:'Barely used — my New Year\u2019s resolution lasted exactly two weeks. No judgement.'},
 {id:18,t:'Electric kettle — rapid boil', price:12, cat:'dorm', cond:'Like new', emoji:'☕', s:'Jordan P.', dorm:'Oak Hall', mins:45, saves:9, desc:'Boils in 2 minutes, auto shut-off, RA-approved. The ultimate ramen enabler.'},
];

const AVATAR_COLORS = ['#f2542d','#2f6bd8','#17604a','#e0921f','#c94f7c','#0e3d2f'];
const REPLIES = {
  buy:  ['Works for me! I\u2019m free after 4 — meet at the SU lobby?','Nice! Cash or UPI, whatever is easier 👍','Deal. I walk past the library around noon, want to meet there?','Sounds good! It\u2019s cleaned up and ready to go 🙂','Perfect — I can bring it to my 2pm building, it\u2019s right on your way.'],
  swap: ['Hmm interesting! What condition is yours in?','Ooh maybe — could you send a pic of it?','I\u2019d consider it + like ₹10 on top? 😄','Yeah let\u2019s do it! When are you free to meet up?'],
};
const TICKER_SEED = [
  '🛡 New policy: every electronic now carries a 1-month warranty','💻 Just in: HP Pavilion 15 laptop — warranty included',
  '📱 Redmi Note 12 listed — 96% battery + warranty','🔥 “Nintendo Switch + 3 games” is trending · 34 saves',
  '⇄ Devon swapped a desk chair for a kettle','🎟️ 2× Spring Fling tickets just dropped',
  '🆓 Free moving boxes outside Elm laundry','📚 Textbook season is ON — 6 new listings today',
];

/* ================= STATE ================= */
const state = { q:'', cat:'all', cond:'any', sort:'new', swapsOnly:false, freeOnly:false, warrOnly:false, savedOnly:false };
const saved = new Set();
const threads = {};
let chatItem = null, chatMode = 'buy', nextId = 100;
let reportTarget = null, reportCounter = 481;
const $ = s => document.querySelector(s);

/* ================= HELPERS ================= */
const esc = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const initials = n => n.split(/\s+/).map(w=>w[0]).join('').slice(0,2).toUpperCase();
const avColor = n => AVATAR_COLORS[n.split('').reduce((a,c)=>a+c.charCodeAt(0),0) % AVATAR_COLORS.length];
function timeAgo(m){ if(m<1) return 'just now'; if(m<60) return m+'m ago'; if(m<1440) return Math.floor(m/60)+'h ago'; return Math.floor(m/1440)+'d ago'; }
function priceHTML(p){ return p===0 ? '<span class="free-tag">FREE</span>' : `<span class="price">₹${p}</span>`; }

function toast(msg, action){
  const t = document.createElement('div'); t.className='toast';
  t.innerHTML = `<span>${msg}</span>`;
  if(action){
    const b = document.createElement('button');
    b.className='undo'; b.textContent = action.label;
    b.addEventListener('click', ()=>{ action.fn(); t.remove(); });
    t.appendChild(b);
  }
  $('#toasts').appendChild(t);
  setTimeout(()=>{ t.classList.add('out'); setTimeout(()=>t.remove(),320); }, action ? 4800 : 3200);
}

/* ================= TICKERS ================= */
let tickerItems = [...TICKER_SEED];
function renderTicker(){
  const html = tickerItems.map(i=>`<span>${i}</span>`).join('<span class="sep">✦</span>');
  $('#tickerTrack').innerHTML = html + '<span class="sep">✦</span>' + html;
}
function pushTicker(txt){ tickerItems.unshift(txt); tickerItems = tickerItems.slice(0,12); renderTicker(); }
(function footTicker(){
  const bits = ['TEXTBOOKS','TECH','FURNITURE','DORM LIFE','FASHION','TICKETS','SPORTS','FREE STUFF'].map(w=>`<span>${w}</span>`).join('<span class="sep">★</span>');
  $('#tickerFoot').innerHTML = bits + '<span class="sep">★</span>' + bits;
})();
renderTicker();

/* ================= FILTER / SORT ================= */
function passes(it){
  if(state.savedOnly && !saved.has(it.id)) return false;
  if(state.cat!=='all' && it.cat!==state.cat) return false;
  if(state.cond!=='any' && it.cond!==state.cond) return false;
  if(state.swapsOnly && !it.trade) return false;
  if(state.freeOnly && it.price!==0) return false;
  if(state.warrOnly && !it.warranty) return false;
  if(state.q){
    const hay = (it.t+' '+it.desc+' '+CATS[it.cat].label+' '+it.dorm+' '+it.s).toLowerCase();
    if(!hay.includes(state.q.toLowerCase())) return false;
  }
  return true;
}
function sortItems(list){
  const c = [...list];
  if(state.sort==='new') c.sort((a,b)=>a.mins-b.mins);
  if(state.sort==='lo')  c.sort((a,b)=>a.price-b.price);
  if(state.sort==='hi')  c.sort((a,b)=>b.price-a.price);
  if(state.sort==='az')  c.sort((a,b)=>a.t.localeCompare(b.t));
  return c;
}

/* ================= RENDER ================= */
function renderChips(){
  const counts = {}; CAT_ORDER.forEach(c=>counts[c]=0);
  ITEMS.forEach(i=>counts[i.cat]++);
  let html = `<button class="chip ${state.cat==='all'?'on':''}" data-cat="all">All<b>${ITEMS.length}</b></button>`;
  CAT_ORDER.forEach(c=>{
    html += `<button class="chip ${state.cat===c?'on':''}" data-cat="${c}">${CATS[c].label}<b>${counts[c]}</b></button>`;
  });
  $('#chips').innerHTML = html;
}

function cardHTML(it, i){
  const c = CATS[it.cat];
  const tilt = ((i%5)-2)*0.8;
  const isSaved = saved.has(it.id);
  return `
  <article class="card" style="--tilt:${tilt}deg;animation-delay:${Math.min(i*45,420)}ms" data-id="${it.id}" tabindex="0" aria-label="${esc(it.t)}, ${it.price===0?'free':'₹'+it.price}">
    <span class="pin"></span>
    ${it.hot ? '<span class="hot-sticker">🔥 HOT</span>' : ''}
    ${it.isNew ? '<span class="hot-sticker new-sticker">✨ NEW</span>' : ''}
    ${it.reported ? '<span class="hot-sticker flag-sticker">⚑ REVIEW</span>' : ''}
    <div class="art ${c.pat}" style="--p1:${c.p1};--p2:${c.p2}"><span>${it.emoji}</span></div>
    <div class="card-body">
      <div class="card-tags"><span class="tag">${c.label}</span><span class="cond">${it.cond}</span>${it.warranty?'<span class="warr-tag">🛡 1-mo warranty</span>':''}</div>
      <h3>${esc(it.t)}</h3>
      <div class="meta">📍 ${esc(it.dorm)} · ${timeAgo(it.mins)}</div>
      <div class="card-foot">
        ${priceHTML(it.price)}
        ${it.trade ? '<span class="swap-chip">⇄</span>' : ''}
        <button class="heart ${isSaved?'on':''}" data-fav="${it.id}" aria-label="Save item">${isSaved?'♥':'♡'} <b>${it.saves + (isSaved?1:0)}</b></button>
        <button class="report-mini" data-rep="${it.id}" title="Report this listing" aria-label="Report this listing">⚑</button>
      </div>
    </div>
  </article>`;
}

function renderGrid(){
  const list = sortItems(ITEMS.filter(passes));
  $('#grid').innerHTML = list.map(cardHTML).join('');
  $('#empty').style.display = list.length ? 'none' : 'block';
  $('#count').textContent = `Showing ${list.length} of ${ITEMS.length} pinned items` + (state.savedOnly ? ' · saved only' : '');
  const filtering = state.q || state.cat!=='all' || state.cond!=='any' || state.swapsOnly || state.freeOnly || state.warrOnly || state.savedOnly;
  $('#clearBtn').hidden = !filtering;
}

function updateSavedUI(){
  $('#savedCount').textContent = saved.size;
  $('#savedBtn').classList.toggle('on', state.savedOnly);
}

function renderAll(){ renderChips(); renderGrid(); updateSavedUI(); }

/* ================= EVENTS: TOOLBAR ================= */
function setQuery(v){
  state.q = v;
  $('#q1').value = v; $('#q2').value = v;
  renderGrid();
}
$('#q1').addEventListener('input', e=>setQuery(e.target.value));
$('#q2').addEventListener('input', e=>setQuery(e.target.value));
$('#heroSearch').addEventListener('submit', e=>{ e.preventDefault(); $('#board').scrollIntoView({behavior:'smooth'}); });
$('#condSel').addEventListener('change', e=>{ state.cond = e.target.value; renderGrid(); });
$('#sortSel').addEventListener('change', e=>{ state.sort = e.target.value; renderGrid(); });
$('#swapTgl').addEventListener('click', ()=>{ state.swapsOnly=!state.swapsOnly; $('#swapTgl').classList.toggle('on',state.swapsOnly); renderGrid(); });
$('#freeTgl').addEventListener('click', ()=>{ state.freeOnly=!state.freeOnly; $('#freeTgl').classList.toggle('on',state.freeOnly); renderGrid(); });
$('#warrTgl').addEventListener('click', ()=>{ state.warrOnly=!state.warrOnly; $('#warrTgl').classList.toggle('on',state.warrOnly); renderGrid(); });

document.addEventListener('click', e=>{
  const chip = e.target.closest('.chip');
  if(chip){ state.cat = chip.dataset.cat; renderAll(); return; }
  const fc = e.target.closest('[data-fcat]');
  if(fc){ state.cat = fc.dataset.fcat; renderAll(); $('#board').scrollIntoView({behavior:'smooth'}); return; }
  const tryBtn = e.target.closest('[data-q]');
  if(tryBtn){ setQuery(tryBtn.dataset.q); $('#board').scrollIntoView({behavior:'smooth'}); return; }
  if(e.target.closest('#clearBtn') || e.target.closest('#emptyClear')){ resetFilters(); return; }
  if(e.target.closest('#savedBtn')){
    state.savedOnly = !state.savedOnly; updateSavedUI(); renderGrid();
    toast(state.savedOnly ? '♥ Showing your saved items' : 'Showing everything again'); return;
  }
});

function resetFilters(){
  state.q=''; state.cat='all'; state.cond='any'; state.swapsOnly=false; state.freeOnly=false; state.warrOnly=false; state.savedOnly=false;
  $('#q1').value=''; $('#q2').value=''; $('#condSel').value='any';
  $('#swapTgl').classList.remove('on'); $('#freeTgl').classList.remove('on'); $('#warrTgl').classList.remove('on');
  renderAll();
}

/* ================= EVENTS: GRID (fav + report + open) ================= */
$('#grid').addEventListener('click', e=>{
  const rep = e.target.closest('[data-rep]');
  if(rep){ openReport(ITEMS.find(i=>i.id===+rep.dataset.rep)); return; }
  const fav = e.target.closest('[data-fav]');
  if(fav){ toggleFav(+fav.dataset.fav); return; }
  const card = e.target.closest('.card');
  if(card) openItem(+card.dataset.id);
});
$('#grid').addEventListener('keydown', e=>{
  if(e.key==='Enter' && e.target.classList.contains('card')) openItem(+e.target.dataset.id);
});

function toggleFav(id){
  const it = ITEMS.find(i=>i.id===id);
  if(saved.has(id)){ saved.delete(id); toast('Removed from saved'); }
  else { saved.add(id); toast(`♥ Saved “${esc(it.t.length>26?it.t.slice(0,26)+'…':it.t)}”`); pushTicker(`♥ You saved “${it.t}”`); }
  renderGrid(); updateSavedUI();
}

/* ================= MODAL PLUMBING ================= */
function openModal(id){ $(id).classList.add('open'); document.body.style.overflow='hidden'; }
function closeModal(el){ el.classList.remove('open'); if(!document.querySelector('.modal.open')) document.body.style.overflow=''; }
document.querySelectorAll('.modal').forEach(m=>{
  m.addEventListener('click', e=>{ if(e.target.closest('[data-close]')) closeModal(m); });
});
document.addEventListener('keydown', e=>{
  if(e.key==='Escape'){
    const open = [...document.querySelectorAll('.modal.open')].pop();
    if(open) closeModal(open);
  }
  if(e.key==='/' && !/INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName)){
    e.preventDefault(); $('#q2').focus();
  }
});
document.querySelectorAll('[data-open-post]').forEach(b=>b.addEventListener('click', ()=>{ openModal('#postModal'); $('#fTitle').focus(); }));

/* ================= ITEM DETAIL ================= */
let currentItem = null;
function openItem(id){
  const it = ITEMS.find(i=>i.id===id); if(!it) return;
  currentItem = it;
  const c = CATS[it.cat];
  $('#imCat').textContent = `${c.label} · ${it.cond}`;
  $('#itemBody').innerHTML = `
    <div class="item-art ${c.pat}" style="--p1:${c.p1};--p2:${c.p2}"><span>${it.emoji}</span></div>
    <div class="item-info">
      <div class="card-tags"><span class="tag">${c.label}</span><span class="cond">${it.cond}</span>${it.warranty?'<span class="warr-tag">🛡 1-month warranty</span>':''}${it.trade?'<span class="swap-chip">⇄ swaps ok</span>':''}${it.reported?'<span class="swap-chip" style="border-color:var(--orange);color:var(--orange)">⚑ under review</span>':''}</div>
      <h2>${esc(it.t)}</h2>
      <div class="item-price-row">${priceHTML(it.price)}<span class="meta">pinned ${timeAgo(it.mins)} · ♥ ${it.saves + (saved.has(it.id)?1:0)} saves</span></div>
      <p class="desc">${esc(it.desc)}</p>
      ${it.warranty ? `<div class="warr-box">🛡 1-MONTH WARRANTY — if this stops working within 30 days, you get a full refund. Backed by @kartmods, no paperwork needed.</div>` : ''}
      <div class="seller-card">
        <span class="avatar" style="background:${avColor(it.s)}">${initials(it.s)}</span>
        <div><b>${esc(it.s)}</b><small>📍 ${esc(it.dorm)} · ⭐ 4.9 · ${3 + (it.id % 9)} trades</small></div>
      </div>
      <div class="item-actions">
        <button class="btn btn-orange" data-chat="buy">💬 Message ${esc(it.s.split(' ')[0])}</button>
        <button class="btn btn-green" data-chat="swap">⇄ Propose a swap</button>
        <button class="btn btn-paper" data-report>🚩 Report</button>
      </div>
      <p class="safety">🤝 Meet in public · 👀 Inspect before paying · 🚩 Report anything sus to @kartmods</p>
    </div>`;
  openModal('#itemModal');
}
$('#itemBody').addEventListener('click', e=>{
  const rep = e.target.closest('[data-report]');
  if(rep && currentItem){ openReport(currentItem); return; }
  const btn = e.target.closest('[data-chat]');
  if(btn && currentItem) openChat(currentItem, btn.dataset.chat);
});

/* ================= REPORT ================= */
function openReport(it){
  if(!it) return;
  if(it.reported){
    toast(`⚑ Already under review — case ${it.caseId} · @kartmods on it`);
    return;
  }
  reportTarget = it;
  $('#repItem').textContent = `“${it.t}” · listed by ${it.s}`;
  document.querySelectorAll('.reason').forEach(r=>r.classList.remove('sel'));
  $('#repDesc').value = '';
  openModal('#reportModal');
}
$('#reasons').addEventListener('click', e=>{
  const r = e.target.closest('.reason'); if(!r) return;
  document.querySelectorAll('.reason').forEach(x=>x.classList.remove('sel'));
  r.classList.add('sel');
});
$('#repSubmit').addEventListener('click', ()=>{
  const sel = document.querySelector('.reason.sel');
  if(!sel){ toast('✋ Pick a reason first'); return; }
  const it = reportTarget;
  it.reported = sel.dataset.r;
  it.caseId = 'R-' + (++reportCounter);
  closeModal($('#reportModal'));
  closeModal($('#itemModal'));
  renderGrid();
  pushTicker(`🚩 A listing was flagged (${it.reported}) — @kartmods reviewing`);
  const short = it.t.length > 24 ? it.t.slice(0,24) + '…' : it.t;
  toast(`🚩 ${it.caseId} sent — “${esc(short)}” is under review`, {
    label: 'Undo',
    fn(){
      it.reported = null; it.caseId = null;
      renderGrid();
      toast('Report withdrawn ✔');
    }
  });
});

/* ================= CHAT ================= */
function addBubble(who, text){
  const b = document.createElement('div');
  b.className = 'bub ' + who;
  b.innerHTML = esc(text);
  $('#chatBody').appendChild(b);
  $('#chatBody').scrollTop = $('#chatBody').scrollHeight;
  return b;
}
function sellerReply(mode, delay=1100){
  setTimeout(()=>{
    const t = document.createElement('div');
    t.className = 'bub them typing'; t.innerHTML = '<i></i><i></i><i></i>';
    $('#chatBody').appendChild(t); $('#chatBody').scrollTop = $('#chatBody').scrollHeight;
    setTimeout(()=>{
      t.remove();
      const pool = REPLIES[mode] || REPLIES.buy;
      addBubble('them', pool[Math.floor(Math.random()*pool.length)]);
    }, delay);
  }, 350);
}
function openChat(it, mode){
  chatItem = it; chatMode = mode;
  $('#chName').textContent = it.s;
  const av = $('#chAvatar'); av.textContent = initials(it.s); av.style.background = avColor(it.s);
  $('#chatBody').innerHTML = '';
  if(!threads[it.id]){
    threads[it.id] = true;
    if(mode==='swap'){
      addBubble('sys','⇄ SWAP REQUEST SENT');
      addBubble('me', `Hi ${it.s.split(' ')[0]}! Would you swap “${it.t}” for something of mine?`);
      sellerReply('swap', 1300);
    } else {
      addBubble('them', `Hey! Yep, “${it.t.length>30?it.t.slice(0,30)+'…':it.t}” is still available 🙂`);
    }
    toast(`💬 Chat started with ${esc(it.s)} — they reply fast`);
    pushTicker(`💬 You messaged ${it.s} about “${it.t}”`);
  } else if(mode==='swap'){
    addBubble('sys','⇄ SWAP REQUEST SENT');
    sellerReply('swap');
  } else {
    addBubble('them', 'Hey again! Still interested? 😊');
  }
  openModal('#chatModal');
  setTimeout(()=>$('#chatText').focus(), 80);
}
$('#chatForm').addEventListener('submit', e=>{
  e.preventDefault();
  const v = $('#chatText').value.trim();
  if(!v) return;
  addBubble('me', v);
  $('#chatText').value = '';
  if(/swap|trade/i.test(v)) sellerReply('swap'); else sellerReply(chatMode);
});

/* ================= POST FORM ================= */
const catSel = $('#fCat');
CAT_ORDER.forEach(c=>{ const o = document.createElement('option'); o.value=c; o.textContent=CATS[c].label; catSel.appendChild(o); });
let pickedEmoji = CATS[catSel.value].emojis[0];
function renderEmojiRow(){
  $('#emojiRow').innerHTML = CATS[catSel.value].emojis.map(e=>
    `<button type="button" class="emoji-btn ${e===pickedEmoji?'sel':''}" data-e="${e}">${e}</button>`).join('');
}
function syncCatUI(){
  pickedEmoji = CATS[catSel.value].emojis[0];
  renderEmojiRow();
  $('#warrHint').hidden = catSel.value !== 'tech';
}
catSel.addEventListener('change', syncCatUI);
$('#emojiRow').addEventListener('click', e=>{
  const b = e.target.closest('[data-e]'); if(!b) return;
  pickedEmoji = b.dataset.e; renderEmojiRow();
});
syncCatUI();

$('#postSubmit').addEventListener('click', ()=>{
  const title = $('#fTitle').value.trim();
  const name  = $('#fName').value.trim();
  if(!title){ toast('✋ Give your item a title first!'); $('#fTitle').focus(); return; }
  if(!name){ toast('✋ Buyers need to know who you are!'); $('#fName').focus(); return; }
  const price = Math.max(0, parseInt($('#fPrice').value,10) || 0);
  const isTech = catSel.value === 'tech';
  const item = {
    id: ++nextId, t:title, price, cat:catSel.value, cond:$('#fCond').value,
    emoji:pickedEmoji, s:name, dorm:$('#fDorm').value.trim() || 'Campus',
    mins:0, saves:0, trade:$('#fTrade').checked,
    warranty: isTech ? 1 : 0,
    desc:$('#fDesc').value.trim() || 'No description yet — message the seller!', isNew:true,
  };
  ITEMS.unshift(item);
  if(!passes(item)){ state.q=''; state.cat='all'; state.cond='any'; state.swapsOnly=false; state.freeOnly=false; state.warrOnly=false; state.savedOnly=false;
    $('#q1').value=''; $('#q2').value=''; $('#condSel').value='any';
    $('#swapTgl').classList.remove('on'); $('#freeTgl').classList.remove('on'); $('#warrTgl').classList.remove('on'); }
  state.sort='new'; $('#sortSel').value='new';
  renderAll();
  $('#statListings').textContent = ITEMS.length;
  closeModal($('#postModal'));
  $('#postForm').reset(); syncCatUI();
  pushTicker(`📌 ${name} just pinned “${title}”${isTech ? ' · 🛡 warranty included' : ''}`);
  toast(isTech ? '📌 Pinned to the board! 🛡 1-month warranty auto-added (electronics policy)' : '📌 Pinned to the board!');
  setTimeout(()=>{
    $('#board').scrollIntoView({behavior:'smooth'});
    const el = document.querySelector(`[data-id="${item.id}"]`);
    if(el) el.classList.add('flash');
  }, 120);
});

/* ================= COUNTERS & REVEALS ================= */
function animateCount(el){
  const target = el.id==='statListings' ? ITEMS.length : parseInt(el.dataset.count,10);
  const dur = 1300, t0 = performance.now();
  (function step(t){
    const p = Math.min(1,(t-t0)/dur), ease = 1-Math.pow(1-p,3);
    el.textContent = Math.round(target*ease).toLocaleString();
    if(p<1) requestAnimationFrame(step);
  })(t0);
}
document.querySelectorAll('[data-count], #statListings').forEach(animateCount);

const io = new IntersectionObserver(entries=>{
  entries.forEach(en=>{ if(en.isIntersecting){ en.target.classList.add('in'); io.unobserve(en.target); } });
},{threshold:.12});
document.querySelectorAll('.reveal').forEach(el=>io.observe(el));

/* ================= INIT ================= */
renderAll();
</script>
</body>
