<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CampusKart — Campus Marketplace</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>📌</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Permanent+Marker&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
<style>
/* ============ TOKENS & BASE ============ */
:root{
  --ink:#22271f;
  --paper:#f2ecdb;
  --card:#fffdf4;
  --green:#17604a;
  --green-deep:#0e3d2f;
  --orange:#f2542d;
  --yellow:#ffc72c;
  --blue:#2f6bd8;
  --pink:#ff90b3;
  --disp:'Archivo Black',sans-serif;
  --body:'Space Grotesk',sans-serif;
  --marker:'Permanent Marker',cursive;
  --shadow:5px 6px 0 var(--ink);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  font-family:var(--body);color:var(--ink);background:var(--paper);
  background-image:radial-gradient(rgba(34,39,31,.09) 1.1px,transparent 1.2px);
  background-size:22px 22px;line-height:1.5;overflow-x:hidden;
}
body::after{ /* paper grain */
  content:"";position:fixed;inset:0;z-index:100;pointer-events:none;opacity:.05;mix-blend-mode:multiply;
  background-image:url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="160" height="160"><filter id="n"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2"/></filter><rect width="160" height="160" filter="url(%23n)" opacity="0.6"/></svg>');
}
::selection{background:var(--yellow)}
img{max-width:100%}
button{font-family:inherit;cursor:pointer}
a{color:inherit;text-decoration:none}
:focus-visible{outline:3px dashed var(--orange);outline-offset:3px}
.wrap{max-width:1200px;margin:0 auto;padding:0 24px}

/* ============ BUTTONS / CHIPS ============ */
.btn{
  font-family:var(--disp);font-size:.85rem;letter-spacing:.5px;color:var(--ink);
  background:var(--yellow);border:2px solid var(--ink);border-radius:9px;
  padding:11px 18px;box-shadow:4px 4px 0 var(--ink);
  transition:transform .15s,box-shadow .15s;white-space:nowrap;
}
.btn:hover{transform:translate(-2px,-2px);box-shadow:6px 6px 0 var(--ink)}
.btn:active{transform:translate(3px,3px);box-shadow:1px 1px 0 var(--ink)}
.btn-orange{background:var(--orange);color:var(--paper)}
.btn-green{background:var(--green);color:var(--paper)}
.btn-paper{background:var(--card)}
.chip{
  font-family:var(--body);font-weight:700;font-size:.82rem;border:2px solid var(--ink);
  background:var(--card);border-radius:999px;padding:7px 14px;box-shadow:3px 3px 0 var(--ink);
  transition:all .15s;white-space:nowrap;
}
.chip:hover{background:var(--yellow);transform:translateY(-2px)}
.chip.on{background:var(--ink);color:var(--paper);transform:none}
.chip b{opacity:.6;font-weight:500;margin-left:4px}

/* ============ TICKER ============ */
.ticker{background:var(--ink);color:var(--paper);overflow:hidden;border-bottom:2px solid var(--ink);font-size:.82rem;letter-spacing:.4px}
.ticker-track{display:flex;width:max-content;gap:2.5rem;padding:9px 0;animation:tick 32s linear infinite}
.ticker:hover .ticker-track{animation-play-state:paused}
.ticker .sep{color:var(--yellow)}
.ticker.rev{border-top:2px solid var(--ink)}
.ticker.rev .ticker-track{animation-direction:reverse;font-family:var(--disp);font-size:.9rem;color:rgba(242,236,219,.85)}
@keyframes tick{to{transform:translateX(-50%)}}

/* ============ HEADER ============ */
.site-head{
  position:sticky;top:0;z-index:60;background:var(--paper);border-bottom:2px solid var(--ink);
}
.site-head .wrap{display:flex;align-items:center;gap:22px;padding-top:14px;padding-bottom:14px;flex-wrap:wrap}
.logo{display:flex;align-items:center;gap:11px}
.logo-badge{
  font-family:var(--disp);font-size:1.3rem;width:44px;height:44px;display:grid;place-items:center;
  background:var(--yellow);border:2px solid var(--ink);border-radius:10px;box-shadow:3px 3px 0 var(--ink);
  transform:rotate(-5deg);transition:transform .25s;
}
.logo:hover .logo-badge{transform:rotate(5deg) scale(1.06)}
.logo-text{font-family:var(--disp);font-size:1.25rem;line-height:1}
.logo-text small{display:block;font-family:var(--body);font-weight:700;font-size:.58rem;letter-spacing:2.5px;color:var(--green);margin-top:3px}
.site-head nav{display:flex;gap:20px;font-weight:700;font-size:.92rem;margin-left:8px}
.site-head nav a{position:relative;padding:4px 0}
.site-head nav a::after{content:"";position:absolute;left:0;right:0;bottom:0;height:4px;background:var(--yellow);transform:scaleX(0);transform-origin:left;transition:transform .25s}
.site-head nav a:hover::after{transform:scaleX(1)}
.head-actions{display:flex;align-items:center;gap:12px;margin-left:auto}
.live{display:flex;align-items:center;gap:7px;font-size:.8rem;font-weight:700;color:var(--green)}
.live i{width:9px;height:9px;border-radius:50%;background:var(--green);animation:pulse 1.6s ease infinite}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(23,96,74,.5)}50%{box-shadow:0 0 0 6px rgba(23,96,74,0)}}
#savedBtn.on{background:var(--pink)}

/* ============ HERO ============ */
.hero{padding:56px 0 46px;position:relative}
.hero .wrap{display:grid;grid-template-columns:1.15fr .85fr;gap:40px;align-items:center}
.kicker{
  display:inline-block;font-weight:700;font-size:.72rem;letter-spacing:2px;
  background:var(--card);border:2px solid var(--ink);padding:5px 12px;border-radius:6px;
  box-shadow:3px 3px 0 var(--ink);transform:rotate(-1deg);margin-bottom:22px;
}
.hero h1{font-family:var(--disp);font-size:clamp(2.6rem,5.6vw,4.4rem);line-height:.98;letter-spacing:-1px;text-transform:uppercase}
.hero h1 .hl{position:relative;display:inline-block;padding:0 10px;z-index:1}
.hero h1 .hl::before{
  content:"";position:absolute;inset:14% -2% 4% -2%;background:var(--yellow);z-index:-1;
  transform:skew(-5deg) rotate(-1.2deg);border-radius:3px;
}
.hero p.sub{max-width:52ch;margin:20px 0 26px;font-size:1.06rem}
.search-big{display:flex;max-width:560px}
.search-big input{
  flex:1;font:500 1rem var(--body);padding:15px 18px;border:2px solid var(--ink);
  border-right:none;border-radius:10px 0 0 10px;background:var(--card);
}
.search-big input:focus{outline:none;box-shadow:-3px 4px 0 var(--yellow),4px 4px 0 var(--yellow)}
.search-big button{border-radius:0 10px 10px 0;font-size:.95rem;padding:15px 22px}
.try{margin-top:14px;font-size:.85rem;font-weight:500;display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.try button{border:none;background:none;font:inherit;font-weight:700;color:var(--green);text-decoration:underline wavy var(--orange) 1.5px;text-underline-offset:4px;transition:color .15s}
.try button:hover{color:var(--orange)}
.stats{display:flex;gap:34px;margin-top:36px;flex-wrap:wrap}
.stat b{display:block;font-family:var(--disp);font-size:2rem;color:var(--green)}
.stat span{font-size:.78rem;font-weight:700;letter-spacing:1px;text-transform:uppercase;opacity:.75}

/* hero collage */
.collage{position:relative;min-height:400px}
.mini-card{
  position:absolute;top:44px;left:34px;width:min(300px,78%);background:var(--card);
  border:2px solid var(--ink);border-radius:10px;box-shadow:8px 9px 0 var(--ink);
  transform:rotate(3deg);padding:12px;transition:transform .3s;
}
.mini-card:hover{transform:rotate(0) translateY(-6px)}
.mini-art{height:130px;border:2px solid var(--ink);border-radius:7px;display:grid;place-items:center;font-size:56px;background:repeating-linear-gradient(45deg,var(--p1) 0 14px,var(--p2) 14px 28px)}
.mini-card h4{font-family:var(--disp);font-size:.95rem;margin:10px 2px 6px}
.mini-row{display:flex;align-items:center;justify-content:space-between;padding:0 2px 2px;gap:8px}
.price{font-family:var(--disp);font-size:1.15rem}
.tag-mini{font-size:.72rem;font-weight:700;border:2px solid var(--blue);color:var(--blue);border-radius:6px;padding:2px 8px}
.tag-mini.gr{border-color:var(--green);color:var(--green)}
.sticker{
  position:absolute;top:-14px;right:-12px;font-family:var(--disp);font-size:.68rem;letter-spacing:.5px;
  background:var(--orange);color:var(--paper);border:2px solid var(--ink);border-radius:8px;
  padding:5px 10px;transform:rotate(7deg);box-shadow:3px 3px 0 var(--ink);
}
.hero-note{
  position:absolute;bottom:26px;right:8px;width:190px;background:#fff6bd;border:2px solid var(--ink);
  padding:20px 16px 16px;font-family:var(--marker);font-size:1.05rem;line-height:1.35;
  transform:rotate(-4deg);box-shadow:6px 7px 0 rgba(34,39,31,.85);transition:transform .3s;
}
.hero-note:hover{transform:rotate(-1deg) translateY(-4px)}
.tape{position:absolute;top:-12px;left:50%;width:84px;height:24px;background:rgba(255,224,130,.85);border:1px dashed rgba(34,39,31,.35);transform:translateX(-50%) rotate(-3deg)}
.swap-badge{
  position:absolute;bottom:60px;left:-6px;width:118px;height:118px;border-radius:50%;
  background:var(--pink);border:2px solid var(--ink);display:grid;place-items:center;text-align:center;
  font-family:var(--disp);font-size:.8rem;line-height:1.25;transform:rotate(-9deg);
  box-shadow:5px 6px 0 var(--ink);transition:transform .3s;
}
.swap-badge:hover{transform:rotate(4deg) scale(1.06)}
.spin-badge{position:absolute;top:-24px;right:6px;width:138px;height:138px;animation:spin 16s linear infinite}
.spin-badge text{font:700 12.5px var(--body);letter-spacing:2.4px;fill:var(--ink)}
@keyframes spin{to{transform:rotate(360deg)}}

/* ============ BOARD / TOOLBAR ============ */
.board-head{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;flex-wrap:wrap;margin-bottom:20px}
.board-head h2{font-family:var(--disp);font-size:clamp(1.8rem,3.5vw,2.6rem);text-transform:uppercase}
.board-head .scribble{font-family:var(--marker);color:var(--green);font-size:1.15rem;transform:rotate(-2deg)}
.toolbar{
  position:sticky;top:74px;z-index:50;background:var(--paper);border:2px solid var(--ink);
  border-radius:12px;box-shadow:var(--shadow);padding:14px 16px;margin-bottom:30px;
  display:flex;flex-direction:column;gap:12px;
}
.tb-row1{display:flex;gap:12px;flex-wrap:wrap}
.tb-search{flex:1;min-width:220px;display:flex;align-items:center;gap:8px;background:var(--card);border:2px solid var(--ink);border-radius:9px;padding:9px 14px}
.tb-search input{flex:1;border:none;background:none;font:500 .95rem var(--body)}
.tb-search input:focus{outline:none}
.selects{display:flex;gap:10px;flex-wrap:wrap}
select{
  font:700 .85rem var(--body);border:2px solid var(--ink);border-radius:9px;background:var(--card);
  padding:9px 12px;box-shadow:3px 3px 0 var(--ink);cursor:pointer;
}
.tb-row2{display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap}
.chip-row{display:flex;gap:9px;overflow-x:auto;padding:4px 2px;scrollbar-width:thin}
.chip-row::-webkit-scrollbar{height:8px}
.chip-row::-webkit-scrollbar-thumb{background:rgba(34,39,31,.25);border-radius:8px}
.toggles{display:flex;gap:9px;flex-wrap:wrap}
.tgl{
  font:700 .8rem var(--body);border:2px dashed var(--ink);background:transparent;border-radius:9px;
  padding:8px 13px;transition:all .15s;white-space:nowrap;
}
.tgl:hover{background:var(--card)}
.tgl.on{background:var(--green);color:var(--paper);border-style:solid;box-shadow:3px 3px 0 var(--ink)}
.tb-meta{display:flex;justify-content:space-between;align-items:center;font-size:.82rem;font-weight:700;opacity:.85}
.clear{border:none;background:none;font:700 .82rem var(--body);color:var(--orange);text-decoration:underline}

/* ============ GRID & CARDS ============ */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(248px,1fr));gap:26px;padding:6px 4px 60px}
.card{
  position:relative;background:var(--card);border:2px solid var(--ink);border-radius:10px;
  box-shadow:var(--shadow);transform:rotate(var(--tilt,0deg));cursor:pointer;
  transition:transform .25s cubic-bezier(.34,1.56,.64,1),box-shadow .25s;
  animation:cardIn .5s both;
}
.card:hover{transform:rotate(0) translateY(-7px);box-shadow:9px 11px 0 var(--ink);z-index:2}
@keyframes cardIn{from{opacity:0;transform:translateY(18px) rotate(var(--tilt,0deg))}to{opacity:1;transform:rotate(var(--tilt,0deg))}}
.card.flash{animation:flashRing 1.6s ease}
@keyframes flashRing{0%,100%{box-shadow:var(--shadow)}35%{box-shadow:0 0 0 8px var(--yellow),9px 11px 0 var(--ink)}}
.pin{
  position:absolute;top:-9px;left:50%;width:17px;height:17px;border-radius:50%;z-index:3;
  background:radial-gradient(circle at 34% 30%,#ff8a70,var(--orange) 60%);border:2px solid var(--ink);
  transform:translateX(-50%);transition:transform .2s;
}
.card:hover .pin{animation:wiggle .5s ease}
@keyframes wiggle{25%{transform:translateX(-50%) rotate(-16deg)}60%{transform:translateX(-50%) rotate(12deg)}}
.art{height:148px;display:grid;place-items:center;border-bottom:2px solid var(--ink);border-radius:8px 8px 0 0;overflow:hidden}
.art span{font-size:60px;filter:drop-shadow(3px 4px 0 rgba(34,39,31,.28));transform:rotate(-4deg);transition:transform .3s}
.card:hover .art span{transform:rotate(3deg) scale(1.12)}
/* art patterns */
.pat-lines{background:repeating-linear-gradient(180deg,var(--p1) 0 22px,var(--p2) 22px 24px)}
.pat-dots{background:radial-gradient(var(--p2) 2.6px,var(--p1) 2.7px);background-size:19px 19px}
.pat-stripes{background:repeating-linear-gradient(45deg,var(--p1) 0 14px,var(--p2) 14px 28px)}
.pat-check{background:repeating-conic-gradient(var(--p1) 0 25%,var(--p2) 0 50%);background-size:34px 34px}
.card-body{padding:13px 15px 15px}
.card-tags{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px}
.tag{font-size:.64rem;font-weight:700;letter-spacing:.8px;text-transform:uppercase;border:2px solid var(--blue);color:var(--blue);border-radius:5px;padding:2px 7px}
.cond{font-size:.64rem;font-weight:700;letter-spacing:.6px;background:var(--paper);border:2px solid var(--ink);border-radius:5px;padding:2px 7px}
.warr-tag{font-size:.64rem;font-weight:700;letter-spacing:.4px;border:2px solid var(--green);color:var(--green);background:#e9f4ec;border-radius:5px;padding:2px 7px}
.card h3{font-family:var(--disp);font-size:1rem;line-height:1.28;margin-bottom:6px}
.meta{font-size:.76rem;font-weight:500;opacity:.72;margin-bottom:11px}
.card-foot{display:flex;align-items:center;gap:8px}
.card .price{font-size:1.25rem;margin-right:auto}
.free-tag{font-family:var(--disp);font-size:.8rem;background:var(--yellow);border:2px solid var(--ink);border-radius:7px;padding:3px 9px;transform:rotate(-2deg);margin-right:auto}
.swap-chip{font-size:.7rem;font-weight:700;color:var(--blue);border:2px solid var(--blue);border-radius:6px;padding:2px 7px}
.heart{
  border:2px solid var(--ink);background:var(--card);border-radius:8px;padding:5px 9px;
  font:700 .8rem var(--body);display:flex;align-items:center;gap:4px;transition:all .15s;
}
.heart:hover{background:var(--pink)}
.heart.on{background:var(--orange);color:var(--paper);animation:pop .35s ease}
@keyframes pop{40%{transform:scale(1.35)}}
.report-mini{
  border:2px dashed var(--ink);background:transparent;border-radius:8px;padding:5px 8px;
  font-size:.85rem;line-height:1;opacity:.45;transition:all .15s;
}
.report-mini:hover{opacity:1;background:#cfe3ff;border-style:solid;transform:translateY(-1px)}
.hot-sticker{
  position:absolute;top:8px;right:-9px;z-index:3;font-family:var(--disp);font-size:.62rem;letter-spacing:.5px;
  background:var(--orange);color:var(--paper);border:2px solid var(--ink);border-radius:7px;
  padding:4px 9px;transform:rotate(6deg);box-shadow:2px 3px 0 var(--ink);
}
.new-sticker{background:var(--green)}
.flag-sticker{background:var(--blue);left:-9px;right:auto;top:8px;transform:rotate(-6deg)}
.empty{text-align:center;padding:60px 20px 80px;display:none}
.empty .big{font-size:64px;display:inline-block;animation:wiggle2 2.4s ease infinite}
@keyframes wiggle2{0%,100%{transform:rotate(-6deg)}50%{transform:rotate(6deg)}}
.empty h3{font-family:var(--disp);font-size:1.5rem;margin:12px 0 6px}
.empty p{opacity:.75;margin-bottom:20px}
.empty .btn{margin:0 5px}

/* ============ HOW IT WORKS ============ */
.how{background:var(--green-deep);color:var(--paper);border-top:3px solid var(--ink);border-bottom:3px solid var(--ink);padding:70px 0 80px;position:relative;overflow:hidden}
.how::before,.how::after{content:"";position:absolute;width:150px;height:36px;background:rgba(255,199,44,.28);border:1px dashed rgba(242,236,219,.4)}
.how::before{top:26px;left:-38px;transform:rotate(-35deg)}
.how::after{bottom:30px;right:-40px;transform:rotate(30deg)}
.how-head{margin-bottom:48px}
.kicker.light{background:transparent;color:var(--yellow);border-color:var(--yellow);box-shadow:3px 3px 0 var(--yellow)}
.how h2{font-family:var(--disp);font-size:clamp(2rem,4.2vw,3.2rem);text-transform:uppercase;line-height:1.02}
.how h2 em{font-style:normal;color:var(--yellow)}
.steps{display:grid;grid-template-columns:1fr 70px 1fr 70px 1fr;align-items:center;gap:14px}
.step{border:2px solid var(--ink);border-radius:12px;padding:26px 22px 24px;color:var(--ink);position:relative;transition:transform .3s}
.step:hover{transform:rotate(0) translateY(-6px) !important}
.step .no{font-family:var(--disp);font-size:2.6rem;color:transparent;-webkit-text-stroke:2px var(--ink);line-height:1}
.step h3{font-family:var(--disp);font-size:1.25rem;margin:10px 0 8px}
.step p{font-size:.92rem;line-height:1.5}
.step.s1{background:var(--yellow);transform:rotate(-1.6deg);box-shadow:7px 8px 0 rgba(0,0,0,.35)}
.step.s2{background:var(--card);transform:rotate(1.2deg);box-shadow:7px 8px 0 var(--orange)}
.step.s3{background:var(--pink);transform:rotate(-1deg);box-shadow:7px 8px 0 var(--yellow)}
.step .stamp-mark{position:absolute;top:12px;right:12px;font-family:var(--marker);font-size:.8rem;border:2px solid var(--ink);border-radius:6px;padding:2px 8px;transform:rotate(8deg);opacity:.75}
.squig{width:70px;height:44px;overflow:visible}
.squig path{stroke:var(--paper);stroke-width:3;fill:none;stroke-linecap:round}
.squig .dash{stroke-dasharray:7 9;animation:dashmove 1.1s linear infinite}
@keyframes dashmove{to{stroke-dashoffset:-16}}

/* ============ HOUSE RULES ============ */
.rules{padding:76px 0 84px}
.rules-head{display:flex;align-items:baseline;gap:16px;flex-wrap:wrap;margin-bottom:44px}
.rules-head h2{font-family:var(--disp);font-size:clamp(1.8rem,3.5vw,2.6rem);text-transform:uppercase}
.rules-head span{font-family:var(--marker);color:var(--orange);font-size:1.1rem}
.notes{display:flex;gap:30px;flex-wrap:wrap}
.note{
  position:relative;flex:1;min-width:240px;padding:34px 24px 26px;border:2px solid var(--ink);
  font-size:.95rem;line-height:1.55;transition:transform .3s;
}
.note:hover{transform:rotate(0) translateY(-6px) !important}
.note h3{font-family:var(--marker);font-size:1.15rem;margin-bottom:10px}
.note.n1{background:#fff6bd;transform:rotate(-2deg);box-shadow:7px 8px 0 rgba(34,39,31,.85)}
.note.n2{background:var(--pink);transform:rotate(1.4deg);box-shadow:7px 8px 0 var(--green)}
.note.n3{background:#cfe3ff;transform:rotate(-1.2deg);box-shadow:7px 8px 0 var(--orange)}
.note.n4{background:#d9f0dd;transform:rotate(1.8deg);box-shadow:7px 8px 0 var(--blue)}

/* ============ FOOTER ============ */
footer{background:var(--green-deep);color:var(--paper)}
.foot-main{padding:60px 0 44px;display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:40px}
.foot-main h4{font-family:var(--disp);font-size:clamp(1.7rem,3vw,2.4rem);text-transform:uppercase;line-height:1.05}
.foot-main h4 em{font-style:normal;color:var(--yellow)}
.foot-main .fine{margin-top:16px;font-size:.9rem;opacity:.75;max-width:38ch}
.foot-col b{display:block;font-size:.72rem;letter-spacing:2px;text-transform:uppercase;color:var(--yellow);margin-bottom:14px}
.foot-col a,.foot-col button{display:block;background:none;border:none;color:var(--paper);font:500 .92rem var(--body);padding:4px 0;opacity:.85;transition:all .15s;text-align:left}
.foot-col a:hover,.foot-col button:hover{opacity:1;color:var(--yellow);transform:translateX(5px)}
.foot-bar{border-top:2px solid rgba(242,236,219,.2);padding:16px 0;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;font-size:.8rem;opacity:.8}

/* ============ MODALS ============ */
.modal{position:fixed;inset:0;z-index:90;display:none;place-items:center;padding:20px}
.modal.open{display:grid}
.backdrop{position:absolute;inset:0;background:rgba(20,24,18,.6)}
.sheet{
  position:relative;background:var(--paper);border:3px solid var(--ink);border-radius:14px;
  box-shadow:12px 14px 0 rgba(20,24,18,.85);width:100%;max-height:90vh;overflow:auto;
  animation:popIn .3s cubic-bezier(.34,1.56,.64,1);
}
@keyframes popIn{from{opacity:0;transform:translateY(16px) scale(.95)}}
.sheet-head{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:18px 22px;border-bottom:2px solid var(--ink);position:sticky;top:0;background:var(--paper);z-index:2}
.sheet-head h3{font-family:var(--disp);font-size:1.15rem;text-transform:uppercase}
.x{border:2px solid var(--ink);background:var(--card);border-radius:8px;width:36px;height:36px;font-size:1.1rem;font-weight:700;box-shadow:3px 3px 0 var(--ink);transition:all .15s}
.x:hover{background:var(--orange);color:var(--paper);transform:rotate(90deg)}
/* post form */
#postSheet{max-width:620px}
.form-grid{padding:22px;display:grid;gap:16px}
.f-row{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.field label{display:block;font-size:.72rem;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;margin-bottom:6px}
.field input[type=text],.field input[type=number],.field select,.field textarea{
  width:100%;font:500 .95rem var(--body);border:2px solid var(--ink);border-radius:9px;
  background:var(--card);padding:11px 13px;
}
.field input:focus,.field textarea:focus,.field select:focus{outline:none;box-shadow:3px 3px 0 var(--yellow)}
.field textarea{resize:vertical;min-height:84px}
#warrHint{display:block;font-size:.74rem;color:var(--green);font-weight:700;margin-top:7px}
.emoji-row{display:flex;gap:8px;flex-wrap:wrap}
.emoji-btn{font-size:1.4rem;width:46px;height:46px;border:2px solid var(--ink);border-radius:9px;background:var(--card);transition:all .15s}
.emoji-btn:hover{transform:translateY(-3px)}
.emoji-btn.sel{background:var(--yellow);box-shadow:3px 3px 0 var(--ink);transform:translateY(-3px)}
.check{display:flex;align-items:center;gap:9px;font-weight:700;font-size:.9rem;cursor:pointer}
.check input{width:19px;height:19px;accent-color:var(--green)}
.form-foot{padding:0 22px 24px;display:flex;gap:12px;justify-content:flex-end}
/* item detail */
#itemSheet{max-width:800px}
.item-wrap{display:grid;grid-template-columns:300px 1fr;gap:0}
.item-art{border-right:2px solid var(--ink);display:grid;place-items:center;min-height:320px;font-size:104px}
.item-art span{filter:drop-shadow(5px 6px 0 rgba(34,39,31,.28));animation:float 3.4s ease-in-out infinite}
@keyframes float{50%{transform:translateY(-10px) rotate(3deg)}}
.item-info{padding:26px 26px 28px}
.item-info h2{font-family:var(--disp);font-size:1.5rem;line-height:1.2;margin:12px 0 10px}
.item-price-row{display:flex;align-items:center;gap:14px;margin:6px 0 16px}
.item-price-row .price{font-size:2.1rem}
.item-info .desc{font-size:.98rem;line-height:1.6;margin-bottom:18px}
.warr-box{
  border:2px solid var(--green);background:#e9f4ec;border-radius:9px;padding:11px 14px;
  font-size:.85rem;font-weight:700;line-height:1.5;margin-bottom:18px;
}
.seller-card{display:flex;align-items:center;gap:12px;background:var(--card);border:2px solid var(--ink);border-radius:10px;padding:12px 14px;margin-bottom:20px;box-shadow:3px 3px 0 var(--ink)}
.avatar{width:44px;height:44px;border-radius:50%;border:2px solid var(--ink);display:grid;place-items:center;font-family:var(--disp);font-size:.95rem;color:var(--paper);flex-shrink:0}
.seller-card b{display:block;font-size:.95rem}
.seller-card small{font-size:.78rem;opacity:.75}
.item-actions{display:flex;gap:12px;flex-wrap:wrap}
.safety{margin-top:18px;font-size:.78rem;font-weight:700;opacity:.65}
/* report */
#reportSheet{max-width:520px}
.report-body{padding:22px}
.report-item{font-family:var(--disp);font-size:.95rem;margin-bottom:8px;line-height:1.4}
.report-note{font-size:.85rem;opacity:.8;margin-bottom:16px}
.reasons{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px}
.reason{
  font:700 .84rem var(--body);border:2px solid var(--ink);background:var(--card);
  border-radius:9px;padding:11px 12px;text-align:left;transition:all .15s;
}
.reason:hover{transform:translateY(-2px);box-shadow:3px 3px 0 var(--ink)}
.reason.sel{background:var(--ink);color:var(--paper);box-shadow:3px 3px 0 var(--orange)}
#repDesc{
  width:100%;font:500 .92rem var(--body);border:2px solid var(--ink);border-radius:9px;
  background:var(--card);padding:11px 13px;min-height:70px;resize:vertical;margin-bottom:18px;
}
#repDesc:focus{outline:none;box-shadow:3px 3px 0 var(--yellow)}
.report-foot{display:flex;gap:12px;justify-content:flex-end}
/* chat */
#chatModal{z-index:95}
#chatSheet{max-width:440px;display:flex;flex-direction:column}
.chat-head{display:flex;align-items:center;gap:12px;padding:16px 18px;border-bottom:2px solid var(--ink)}
.chat-head .avatar{width:40px;height:40px}
.chat-head b{display:block;font-size:.95rem}
.chat-head small{display:flex;align-items:center;gap:6px;font-size:.75rem;color:var(--green);font-weight:700}
.chat-head small i{width:8px;height:8px;border-radius:50%;background:var(--green);animation:pulse 1.6s ease infinite}
.chat-body{height:310px;overflow-y:auto;padding:18px;display:flex;flex-direction:column;gap:10px;background:rgba(255,253,244,.6)}
.bub{max-width:82%;border:2px solid var(--ink);border-radius:12px;padding:9px 13px;font-size:.92rem;line-height:1.45;animation:bubIn .3s ease}
@keyframes bubIn{from{opacity:0;transform:translateY(8px)}}
.bub.them{background:var(--card);align-self:flex-start;border-bottom-left-radius:3px}
.bub.me{background:var(--yellow);align-self:flex-end;border-bottom-right-radius:3px}
.bub.sys{align-self:center;font-size:.75rem;font-weight:700;letter-spacing:.6px;background:var(--ink);color:var(--paper);border-radius:999px;padding:5px 14px}
.typing{display:flex;gap:5px;padding:13px 15px}
.typing i{width:7px;height:7px;border-radius:50%;background:var(--ink);animation:bl 1s ease infinite}
.typing i:nth-child(2){animation-delay:.15s}.typing i:nth-child(3){animation-delay:.3s}
@keyframes bl{40%{transform:translateY(-6px);opacity:.5}}
.chat-input{display:flex;gap:10px;padding:14px;border-top:2px solid var(--ink)}
.chat-input input{flex:1;font:500 .95rem var(--body);border:2px solid var(--ink);border-radius:9px;padding:10px 13px;background:var(--card)}
.chat-input input:focus{outline:none;box-shadow:3px 3px 0 var(--yellow)}

/* ============ TOASTS & FAB ============ */
#toasts{position:fixed;bottom:22px;left:22px;z-index:120;display:flex;flex-direction:column;gap:10px}
.toast{
  background:var(--card);border:2px solid var(--ink);border-left:8px solid var(--orange);
  border-radius:9px;box-shadow:5px 6px 0 rgba(34,39,31,.85);padding:12px 18px;font-weight:700;font-size:.9rem;
  animation:toastIn .35s cubic-bezier(.34,1.56,.64,1);max-width:360px;
  display:flex;align-items:center;gap:12px;
}
.toast .undo{border:none;background:none;font:700 .85rem var(--body);color:var(--blue);text-decoration:underline;white-space:nowrap;padding:0}
@keyframes toastIn{from{opacity:0;transform:translateX(-24px)}}
.toast.out{opacity:0;transform:translateX(-24px);transition:all .3s}
.fab{
  position:fixed;bottom:22px;right:22px;z-index:70;width:66px;height:66px;border-radius:50%;
  background:var(--yellow);border:2px solid var(--ink);box-shadow:5px 6px 0 var(--ink);
  font-family:var(--disp);font-size:1.7rem;display:none;place-items:center;transition:transform .2s;
}
.fab:hover{transform:rotate(12deg) scale(1.08)}

/* ============ REVEALS & MOTION PREFS ============ */
.reveal{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s ease}
.reveal.in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation:none!important;transition:none!important}
  .reveal{opacity:1;transform:none}
}

/* ============ RESPONSIVE ============ */
@media (max-width:980px){
  .hero .wrap{grid-template-columns:1fr}
  .collage{min-height:340px;margin-top:10px}
  .steps{grid-template-columns:1fr;gap:26px}
  .squig{transform:rotate(90deg);margin:0 auto}
  .item-wrap{grid-template-columns:1fr}
  .item-art{border-right:none;border-bottom:2px solid var(--ink);min-height:220px}
  .foot-main{grid-template-columns:1fr 1fr}
}
@media (max-width:760px){
  .site-head nav,.live{display:none}
  .toolbar{position:static}
  .fab{display:grid}
  .f-row{grid-template-columns:1fr}
  .foot-main{grid-template-columns:1fr}
  .hero{padding-top:36px}
}
@media (max-width:520px){
  .reasons{grid-template-columns:1fr}
}
</style>
